# Copia questi valori nei "Secrets" di Replit (non nel codice!)
# DATABASE_URL viene creata automaticamente da Replit quando aggiungi il database PostgreSQL.
DATABASE_URL=
# Password iniziale dell'utente "zaira" (usata solo al primo avvio). Predefinita: Zaira
ADMIN_PASSWORD=Zaira
DEFAULT_TENANT=turnover
APP_TIMEZONE=Europe/Rome
# URL pubblico del sito (per i link nei messaggi), es. https://turnoverbyzaira.it
PUBLIC_BASE_URL=
# Chiave per il trigger esterno delle automazioni: /api/cron/tick?key=...
CRON_SECRET=
# --- Email (uno dei due) ---
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM="Turn Over by Zaira <prenotazioni@tuodominio.it>"
# --- WhatsApp Business Platform (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LANG=it
